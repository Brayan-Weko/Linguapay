{
  "manifest_version": 3,
  "name": "LinguaPay — Finance Inclusive Cameroun",
  "version": "0.3.0",
  "description": "Couche d'adaptation linguistique non-intrusive et vocale vers les langues nationales camerounaises.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinguaPay Assist"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
